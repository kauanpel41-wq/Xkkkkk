        window.scrollTo(0, 0);  
    }  

    function salvarNomeEIrComentarios() {  
        const inputNome = document.getElementById('user_name').value;  
        if(inputNome.length < 5) {  
            alert("Por favor, digite seu nome completo para prosseguir.");  
            return;  
